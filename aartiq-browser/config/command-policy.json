{
  "blockedCommands": [
    "sudo", "su", "passwd", "chgrp",
    "shutdown", "reboot", "halt", "poweroff", "init",
    "iptables", "ufw", "firewall-cmd", "firewalld",
    "mkfs", "fdisk", "dd", "format",
    "mount", "umount", "eject",
    "kill", "killall", "pkill",
    "wget", "curl"
  ],
  "blockedPatterns": [
    "rm -rf /", "rm -rf ~",
    ":()", ":\\|:",
    "base64 -d", "base64 --decode",
    "chmod 777", "chmod 755 /",
    "chown root",
    ">/dev/sd", "|< /dev/sd",
    "exec ", "eval ", "source /dev/stdin",
    "$(", "`", "| bash", "| sh",
    "| zsh", "| fish",
    "python -c", "perl -e",
    "openssl enc -d",
    "\\x[0-9a-f]{2}",
    "nc -e", "ncat -e", "ncat --exec",
    "telnet", "ntpq",
    "wget.*-O", "curl.*-o",
    "ssh -o", "ssh -J",
    "scp ", "rsync ",
    "git clone.*--config"
  ],
  "approvalRequiredCommands": [
    "npm install -g", "npm uninstall",
    "pip install", "pip uninstall",
    "gem install",
    "brew install", "brew uninstall",
    "cargo install",
    "go install",
    "dotnet tool install",
    "docker run", "docker exec", "docker compose",
    "systemctl", "service ",
    "launchctl",
    "diskutil",
    "tmux", "screen",
    "nohup",
    "echo >", "cat >",
    "tee",
    "mv ", "cp ", "ln ",
    "mkdir -p /", "rmdir ",
    "crontab",
    "at ",
    "netstat -", "lsof -",
    "tcpdump",
    "nmap",
    "openssl",
    "gpg",
    "sqlite3",
    "psql",
    "mysql",
    "redis-cli",
    "mongosh",
    "node -e", "deno eval", "bun -e"
  ],
  "safeCommands": [
    "ls", "pwd", "echo", "cat", "head", "tail",
    "less", "more", "grep", "rg", "ag",
    "find", "locate", "which", "whereis",
    "date", "cal", "uptime", "whoami",
    "who", "w", "id", "uname",
    "df -h", "du -sh",
    "ps aux", "top", "htop",
    "env", "printenv", "export",
    "history",
    "free -h",
    "wc", "sort", "uniq",
    "cut", "tr", "od",
    "file",
    "basename", "dirname",
    "realpath", "readlink",
    "stat",
    "type",
    "apropos", "whatis",
    "man",
    "help",
    "python --version", "node --version",
    "npm --version", "node -v", "npm -v",
    "git --version", "git status",
    "git log", "git diff",
    "git branch", "git remote",
    "ping", "traceroute",
    "dig", "nslookup", "host",
    "hostname"
  ]
}
