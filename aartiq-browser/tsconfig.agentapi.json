{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "strict": false,
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "src/lib/guardrails",
    "src/lib/agent",
    "src/lib/snapshot",
    "src/lib/autofill",
    "src/lib/extensions",
    "src/lib/theme",
    "src/lib/agent-api"
  ]
}
